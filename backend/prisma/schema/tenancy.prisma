model Tenant {
  id        String       @id @default(uuid(7)) @db.Char(36)
  slug      String       @unique @db.VarChar(63)
  name      String       @db.VarChar(191)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @db.DateTime(3)
  updatedAt DateTime     @updatedAt @db.DateTime(3)

  entities      Entity[]
  users         User[]
  recoveryCodes RecoveryCode[]
  sessions      Session[]
  refreshTokens RefreshToken[]
  jobRecords    JobRecord[]

  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// A legal company inside a tenant (letterheads, signatories and numbering are per entity).
model Entity {
  id        String   @id @default(uuid(7)) @db.Char(36)
  tenantId  String   @db.Char(36)
  name      String   @db.VarChar(191)
  legalName String   @db.VarChar(191)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("entities")
}
