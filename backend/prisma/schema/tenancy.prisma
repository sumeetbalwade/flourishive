model Tenant {
  id        String       @id @default(uuid(7)) @db.Char(36)
  slug      String       @unique @db.VarChar(63)
  name      String       @db.VarChar(191)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @db.DateTime(3)
  updatedAt DateTime     @updatedAt @db.DateTime(3)

  entities            Entity[]
  users               User[]
  recoveryCodes       RecoveryCode[]
  sessions            Session[]
  refreshTokens       RefreshToken[]
  jobRecords          JobRecord[]
  roles               Role[]
  rolePermissions     RolePermission[]
  userRoles           UserRole[]
  settingValues       SettingValue[]
  locations           Location[]
  departments         Department[]
  designations        Designation[]
  persons             Person[]
  engagements         Engagement[]
  internDetails       InternDetail[]
  auditLogs           AuditLog[]
  auditChainHead      AuditChainHead?
  files               File[]
  notifications       Notification[]
  letterheads         Letterhead[]
  numberingSchemes    NumberingScheme[]
  numberingCounters   NumberingCounter[]
  templates           Template[]
  templateVersions    TemplateVersion[]
  generatedDocuments  GeneratedDocument[]
  workflowDefinitions WorkflowDefinition[]
  workflowInstances   WorkflowInstance[]
  workflowActions     WorkflowAction[]

  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// A legal company inside a tenant (letterheads, signatories and numbering are per entity).
model Entity {
  id        String   @id @default(uuid(7)) @db.Char(36)
  tenantId  String   @db.Char(36)
  name      String   @db.VarChar(191)
  legalName String   @db.VarChar(191)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  userRoles          UserRole[]
  engagements        Engagement[]
  letterheads        Letterhead[]
  numberingSchemes   NumberingScheme[]
  generatedDocuments GeneratedDocument[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("entities")
}
