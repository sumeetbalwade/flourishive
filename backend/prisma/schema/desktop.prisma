/// A computer paired with a user so Flourishive Desktop can sign for them. The credential only
/// reaches the signing endpoints; it is stored as a hash and can be revoked at any time.
model DesktopDevice {
  id             String    @id @default(uuid(7)) @db.Char(36)
  tenantId       String    @db.Char(36)
  userId         String    @db.Char(36)
  name           String    @db.VarChar(100)
  platform       String    @db.VarChar(30)
  appVersion     String    @db.VarChar(30)
  credentialHash String    @unique @db.Char(64)
  createdAt      DateTime  @default(now()) @db.DateTime(3)
  lastSeenAt     DateTime? @db.DateTime(3)
  revokedAt      DateTime? @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, userId])
  @@map("desktop_devices")
}
