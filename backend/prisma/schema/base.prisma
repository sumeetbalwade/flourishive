// Shared generator + datasource. Each module keeps its models in its own file
// in this folder (tenancy.prisma, platform.prisma, ...). Every tenant-owned
// model MUST have a `tenantId` column; the scoping extension and the
// cross-tenant test harness both rely on that.
generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
  // ESM output with .js import suffixes, matching the rest of the backend.
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}
