enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  READ_ONLY
  SUSPENDED
  CANCELLED
}

/// A plan the super admin sells (D-20). Prices are in paise. Not tied to one company, so no tenantId.
model Plan {
  id           String   @id @default(uuid(7)) @db.Char(36)
  key          String   @unique @db.VarChar(40)
  name         String   @db.VarChar(80)
  description  String   @default("") @db.VarChar(300)
  priceMonthly Int      @default(0)
  priceYearly  Int      @default(0)
  currency     String   @default("INR") @db.VarChar(3)
  /// Shown to a company choosing a plan. Internal plans (for example Flourisense itself) are not.
  isPublic     Boolean  @default(true)
  /// New companies start on this plan. Exactly one plan carries it.
  isDefault    Boolean  @default(false)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)

  limits        PlanLimit[]
  subscriptions Subscription[]

  @@map("plans")
}

/// One limit of a plan. A missing row, or a null value, means unlimited.
model PlanLimit {
  id     String @id @default(uuid(7)) @db.Char(36)
  planId String @db.Char(36)
  /// users, storage_mb or signatures_month
  metric String @db.VarChar(40)
  value  Int?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, metric])
  @@map("plan_limits")
}

/// Which plan a company is on, and any limits the super admin raised or lowered for it.
model Subscription {
  id                    String             @id @default(uuid(7)) @db.Char(36)
  tenantId              String             @unique @db.Char(36)
  planId                String             @db.Char(36)
  status                SubscriptionStatus @default(ACTIVE)
  /// { "users": 50, "storage_mb": null } replaces the plan's value for that metric (null is unlimited).
  limitOverrides        Json?
  currentPeriodStart    DateTime?          @db.DateTime(3)
  currentPeriodEnd      DateTime?          @db.DateTime(3)
  /// MONTHLY or YEARLY, for the paid plan.
  billingInterval       BillingInterval?
  gatewaySubscriptionId String?            @unique @db.VarChar(64)
  /// Cancelled at the gateway; the plan stays until the paid period ends.
  cancelAtPeriodEnd     Boolean            @default(false)
  /// The plan the company is moving to once the checkout completes.
  pendingPlanId         String?            @db.Char(36)
  /// When a payment first failed. Drives reminders, read-only mode and suspension.
  pastDueSince          DateTime?          @db.DateTime(3)
  lastReminderAt        DateTime?          @db.DateTime(3)
  reminderCount         Int                @default(0)
  updatedBy             String?            @db.Char(36)
  createdAt             DateTime           @default(now()) @db.DateTime(3)
  updatedAt             DateTime           @updatedAt @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@index([planId])
  @@map("subscriptions")
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

/// The plan we created at the gateway for one of our plans, interval and price.
model GatewayPlanRef {
  id            String          @id @default(uuid(7)) @db.Char(36)
  planId        String          @db.Char(36)
  interval      BillingInterval
  amount        Int
  gatewayPlanId String          @db.VarChar(64)
  createdAt     DateTime        @default(now()) @db.DateTime(3)

  @@unique([planId, interval, amount])
  @@map("gateway_plan_refs")
}

enum PaymentStatus {
  CAPTURED
  FAILED
  REFUNDED
}

/// One payment attempt at the gateway for a company's subscription.
model Payment {
  id               String        @id @default(uuid(7)) @db.Char(36)
  tenantId         String        @db.Char(36)
  gatewayPaymentId String        @unique @db.VarChar(64)
  amount           Int
  currency         String        @default("INR") @db.VarChar(3)
  status           PaymentStatus
  method           String?       @db.VarChar(30)
  failureReason    String?       @db.VarChar(300)
  paidAt           DateTime?     @db.DateTime(3)
  createdAt        DateTime      @default(now()) @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("payments")
}

/// Every webhook the gateway sent, once. The gateway event id makes handling idempotent.
model BillingEvent {
  id             String    @id @default(uuid(7)) @db.Char(36)
  gatewayEventId String    @unique @db.VarChar(80)
  type           String    @db.VarChar(60)
  payload        Json
  processedAt    DateTime? @db.DateTime(3)
  error          String?   @db.VarChar(500)
  createdAt      DateTime  @default(now()) @db.DateTime(3)

  @@index([type, createdAt])
  @@map("billing_events")
}

/// Who a company's invoices are made out to. Needed before the first payment.
model BillingProfile {
  id           String   @id @default(uuid(7)) @db.Char(36)
  tenantId     String   @unique @db.Char(36)
  legalName    String   @db.VarChar(191)
  /// Optional. A registered buyer's GSTIN lets them claim input credit.
  gstin        String?  @db.VarChar(15)
  address      String   @db.VarChar(500)
  /// GST state code, two digits ("27" Maharashtra). Decides CGST+SGST or IGST.
  stateCode    String   @db.Char(2)
  billingEmail String   @db.VarChar(191)
  updatedAt    DateTime @updatedAt @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("billing_profiles")
}

/// One tax invoice per captured payment. Amounts are in paise. Seller and buyer are copied in, so
/// an invoice never changes when someone later edits their details.
model Invoice {
  id           String    @id @default(uuid(7)) @db.Char(36)
  tenantId     String    @db.Char(36)
  paymentId    String    @unique @db.Char(36)
  number       String    @unique @db.VarChar(40)
  description  String    @db.VarChar(300)
  periodStart  DateTime? @db.DateTime(3)
  periodEnd    DateTime? @db.DateTime(3)
  sacCode      String    @db.VarChar(10)
  gstRate      Int
  taxableValue Int
  cgst         Int       @default(0)
  sgst         Int       @default(0)
  igst         Int       @default(0)
  total        Int
  seller       Json
  buyer        Json
  fileId       String?   @db.Char(36)
  issuedAt     DateTime  @default(now()) @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, issuedAt])
  @@map("invoices")
}

/// The last invoice number used in each financial year (April to March), so numbers never skip.
model InvoiceCounter {
  fy      String @id @db.VarChar(9)
  lastSeq Int    @default(0)

  @@map("invoice_counters")
}
