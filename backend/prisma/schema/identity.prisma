model User {
  id           String     @id @default(uuid(7)) @db.Char(36)
  tenantId     String     @db.Char(36)
  email        String     @db.VarChar(191) // stored lower-case
  passwordHash String?    @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  googleSub    String?    @db.VarChar(64)
  /// AES-256-GCM encrypted TOTP secret (set at enrolment, active once mfaEnabledAt is set)
  mfaSecretEnc String?    @db.VarChar(255)
  mfaEnabledAt DateTime?  @db.DateTime(3)
  /// Set by the access module for HR, admin and super-admin roles (D-16)
  mfaRequired  Boolean    @default(false)
  lastLoginAt  DateTime?  @db.DateTime(3)
  createdAt    DateTime   @default(now()) @db.DateTime(3)
  updatedAt    DateTime   @updatedAt @db.DateTime(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  recoveryCodes RecoveryCode[]
  sessions      Session[]
  userRoles     UserRole[]
  person        Person?

  @@unique([tenantId, email])
  @@unique([tenantId, googleSub])
  @@index([tenantId])
  @@map("users")
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

model RecoveryCode {
  id        String    @id @default(uuid(7)) @db.Char(36)
  tenantId  String    @db.Char(36)
  userId    String    @db.Char(36)
  codeHash  String    @db.Char(64) // sha256 of the code
  usedAt    DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@map("recovery_codes")
}

/// One sign-in on one device. Refresh tokens rotate inside a session; reusing an
/// old token revokes the whole session.
model Session {
  id        String    @id @default(uuid(7)) @db.Char(36)
  tenantId  String    @db.Char(36)
  userId    String    @db.Char(36)
  userAgent String?   @db.VarChar(255)
  ip        String?   @db.VarChar(64)
  expiresAt DateTime  @db.DateTime(3)
  revokedAt DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([tenantId])
  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Char(36)
  tenantId  String    @db.Char(36)
  sessionId String    @db.Char(36)
  tokenHash String    @unique @db.Char(64) // sha256 of the opaque token
  usedAt    DateTime? @db.DateTime(3)
  expiresAt DateTime  @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

/// A browser that skipped the two-step code after a successful one ("Remember this device"). Only a hash of
/// its cookie is kept. Cleared when two-step is reset or turned off.
model TrustedDevice {
  id         String   @id @default(uuid(7)) @db.Char(36)
  tenantId   String   @db.Char(36)
  userId     String   @db.Char(36)
  tokenHash  String   @unique @db.Char(64)
  label      String   @db.VarChar(120)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  lastUsedAt DateTime @default(now()) @db.DateTime(3)
  expiresAt  DateTime @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, userId])
  @@map("trusted_devices")
}

/// A passkey (WebAuthn credential) a person registered. It signs them in on its own, or counts as their
/// second factor after the password. Only the public key is kept. `rpId` is the host it was made for.
model Passkey {
  id           String   @id @default(uuid(7)) @db.Char(36)
  tenantId     String   @db.Char(36)
  userId       String   @db.Char(36)
  credentialId String   @unique @db.VarChar(512)
  publicKey    Bytes
  counter      Int      @default(0)
  transports   String?  @db.VarChar(255)
  label        String   @db.VarChar(120)
  rpId         String   @db.VarChar(255)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  lastUsedAt   DateTime @default(now()) @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, userId])
  @@map("passkeys")
}
