# Copy to .env for local development. On cPanel, set these in
# "Setup Node.js App" → Environment variables. Never commit real values.
NODE_ENV=development
PORT=3000
APP_VERSION=dev
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Local services (infra/local/setup.sh starts them)
DATABASE_URL=mysql://flourishive:flourishive_dev@127.0.0.1:3306/flourishive_dev
TEST_DATABASE_URL=mysql://flourishive:flourishive_dev@127.0.0.1:3306/flourishive_test
REDIS_URL=redis://127.0.0.1:6379
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
