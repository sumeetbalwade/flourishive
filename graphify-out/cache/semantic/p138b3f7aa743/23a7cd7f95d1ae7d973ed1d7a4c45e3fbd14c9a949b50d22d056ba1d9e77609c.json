": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TypeScript, Tailwind, shadcn/ui, TanStack; static deploy."}, {"id": "docs_00_master_plan_d_07", "label": "D-07 Monorepo", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One Git repo with independently built and deployed apps."}, {"id": "docs_00_master_plan_d_08", "label": "D-08 Dark bronze visual direction", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dark premium black + bronze with light mode; per-tenant logo and accent. Colours superseded by D-53."}, {"id": "docs_00_master_plan_d_09", "label": "D-09 Design process", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coded design system and clickable prototypes approved before building screens."}, {"id": "docs_00_master_plan_d_10", "label": "D-10 Signature methods", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "DSC Class 3 USB token, OTP e-acceptance, Aadhaar eSign."}, {"id": "docs_00_master_plan_d_11", "label": "D-11 DSC signing on desktop", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signing happens entirely inside Flourishive Desktop (pyHanko + PKCS#11); server only verifies and stores; key and PIN never leave signer's computer."}, {"id": "docs_00_master_plan_d_12", "label": "D-12 Desktop platforms", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Windows and macOS at launch."}, {"id": "docs_00_master_plan_d_13", "label": "D-13 Three template paths", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Visual editor, coded React-PDF layouts, HR uploads (PDF, fillable, DOCX). pdfmake part replaced by D-78."}, {"id": "docs_00_master_plan_d_14", "label": "D-14 DOCX to PDF route", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Via Desktop or external conversion API, chosen per tenant by super admin; DOCX deferred by D-42."}, {"id": "docs_00_master_plan_d_15", "label": "D-15 Single tenant URL", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "app.flourishive.in with tenant resolved at login."}, {"id": "docs_00_master_plan_d_16", "label": "D-16 Login policy", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Email+password with MFA, Google sign-in, optional per-tenant SSO. Mandatory-MFA part amended by D-65."}, {"id": "docs_00_master_plan_d_17", "label": "D-17 Messaging", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transactional email (ZeptoMail or SES); SMS after TRAI DLT."}, {"id": "docs_00_master_plan_d_18", "label": "D-18 Domain flourishive.in", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Product domain."}, {"id": "docs_00_master_plan_d_19", "label": "D-19 Phase order: signing first", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Signing built first on a minimal core that is tenant-aware from day one."}, {"id": "docs_00_master_plan_d_20", "label": "D-20 SaaS controls", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tenant creation, module on/off, limits, settings and subscription billing at launch."}, {"id": "docs_00_master_plan_d_21", "label": "D-21 Razorpay payments", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Razorpay Subscriptions/UPI AutoPay behind a payment-gateway adapter."}, {"id": "docs_00_master_plan_d_22", "label": "D-22 GitHub Actions deploy", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build and test in CI, deploy over SSH/rsync; no builds on server."}, {"id": "docs_00_master_plan_d_23", "label": "D-23 Mobile with React Native Expo", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After leave and attendance; PWA before."}, {"id": "docs_00_master_plan_d_24", "label": "D-24 Desktop pairing with API (P-01)", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Desktop pairs with user account and talks to API directly; web opens it via flourishive:// link; no localhost server (avoids Chrome Private Network Access blocks and local HTTPS cert)."}, {"id": "docs_00_master_plan_d_25", "label": "D-25 Organisation seal for OTP docs (P-02)", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OTP-accepted PDFs sealed server-side with organisation certificate so edits show as invalid."}, {"id": "docs_00_master_plan_d_26", "label": "D-26 Toolchain (P-03)", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "pnpm + Turborepo, Vitest, Playwright, lint, uv+pytest. oxlint used in place of ESLint."}, {"id": "docs_00_master_plan_d_27", "label": "D-27 VPS trigger (P-04)", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Move to VPS at first paying external customer or 300 active users."}, {"id": "docs_00_master_plan_d_28", "label": "D-28 Aadhaar eSign provider (P-05)", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compare 2-3 licensed providers in Phase 1, build against adapter, choose before Phase 2."}, {"id": "docs_00_master_plan_d_29", "label": "D-29 Custom fields (P-06)", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ship in Phase 3 for persons and engagements with role-based visibility."}, {"id": "docs_00_master_plan_d_30", "label": "D-30 Job queue on Redis", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "BullMQ in Redis, cron starts worker each minute for ~55s; important jobs mirrored in MySQL job_records with reconciler."}, {"id": "docs_00_master_plan_d_31", "label": "D-31 No Python on server", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Validation and seal run in Node; pyHanko only in Desktop. Trade-off: weaker timestamp and revocation checking."}, {"id": "docs_00_master_plan_d_32", "label": "D-32 Other Redis uses", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rate limits, lockouts, settings/permission cache, short-lived tokens; OTPs and evidence stay in MySQL."}, {"id": "docs_00_master_plan_d_33", "label": "D-33 DSC flow re-confirmed", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "D-11 unchanged; server validates desktop-signed PDF before accepting."}, {"id": "docs_00_master_plan_d_34", "label": "D-34 Local dev on Homebrew", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Homebrew MySQL, Redis, Mailpit, SoftHSM instead of Docker."}, {"id": "docs_00_master_plan_d_35", "label": "D-35 Signatory is HR lead", "file_type": "concept", "source_file": "docs/00-master-plan.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HR l